{
  "schemaVersion": 1,
  "id": "displaykit-showcase",
  "version": "${version}",
  "name": "DisplayKit Showcase",
  "description": "Live demonstrations and acceptance tests for DisplayKit primitives",
  "authors": ["Schemat.io"],
  "contact": {
    "homepage": "https://github.com/Nano112/DisplayKit",
    "sources": "https://github.com/Nano112/DisplayKit",
    "issues": "https://github.com/Nano112/DisplayKit/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.schemat.displaykit.showcase.ShowcaseMod"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "displaykit": "*"
  }
}
